# Copy this file to .env.local and fill in values. Never commit .env.local.

# Supabase project configuration — required to load destinations and stories.
# Dashboard -> Project Settings -> Data API (URL) and API Keys (publishable key).
# The app reads data on the server with the publishable key, so Row Level
# Security always applies. These values are safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...). Not used yet; reserved for
# trusted server operations in later phases (e.g. moderation).
# Never prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SECRET_KEY=

# Gemini API - server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional, server-only: place autocomplete uses the public Photon API
# (https://photon.komoot.io, no key needed, fair use). Set an https URL here only
# to use a self-hosted Photon instance, e.g. https://photon.example.com/api/
PHOTON_API_URL=

# Optional: custom map tile provider URL template. Leave empty to use the OpenStreetMap default.
NEXT_PUBLIC_MAP_TILE_URL=
