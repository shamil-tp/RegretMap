# Copy this file to .env.local and fill in values. Never commit .env.local.

# Supabase project configuration — required to load destinations and stories.
# Dashboard -> Project Settings -> Data API (URL) and API Keys (publishable key).
# The app reads data on the server with the publishable key, so Row Level
# Security always applies. These values are safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_..., or the legacy service_role key).
# Required for story submissions: the server uses it ONLY to insert validated
# stories as status = 'pending'. It bypasses RLS, so never expose it:
# never prefix with NEXT_PUBLIC_ and never import it from client components.
SUPABASE_SECRET_KEY=

# Gemini API - server-side only. Never prefix with NEXT_PUBLIC_.
# Used for AI moderation labels on new submissions (annotate only; never publishes).
# If unset, stories are still saved and marked "unmoderated" for human review.
# Example model: gemini-3.1-flash-lite
# Also powers the AI "Before you go" summaries on destination pages.
# Optional extra keys (GEMINI_API_KEY2, GEMINI_API_KEY3, …): the primary key is
# tried first; another key is used only when one is rate-limited, temporarily
# unavailable or invalid. Rotation doesn't bypass a quota shared by one project.
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_MODEL=

# Server-only: comma-separated emails allowed to use /moderate (publish/reject
# pending stories). The account must sign in with a confirmed email.
MODERATOR_EMAILS=

# Optional, server-only: place autocomplete uses the public Photon API
# (https://photon.komoot.io, no key needed, fair use). Set an https URL here only
# to use a self-hosted Photon instance, e.g. https://photon.example.com/api/
PHOTON_API_URL=

# Optional: custom map tile provider URL template. Leave empty to use the OpenStreetMap default.
NEXT_PUBLIC_MAP_TILE_URL=
